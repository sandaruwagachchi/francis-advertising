# ---- Francis Advertising: speed & SEO settings ----

# 1) Force HTTPS and the non-www address (one canonical URL for Google).
#    Turn this on ONLY after AutoSSL shows a valid certificate:
#    remove the "#" from the 4 lines below.
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} ^www\. [NC]
# RewriteRule ^ https://francisadvertising.lk%{REQUEST_URI} [L,R=301]

# 2) Compress text files so pages load faster
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml image/svg+xml
</IfModule>

# 3) Let browsers cache images for repeat visits
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png  "access plus 6 months"
  ExpiresByType text/html  "access plus 1 hour"
</IfModule>

# 4) Don't list folder contents
Options -Indexes
